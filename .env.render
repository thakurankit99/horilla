# Production environment variables for Render deployment
DEBUG=False

# Generate a new secret key for production: https://djecrety.ir
SECRET_KEY=your-production-secret-key-here

# Your Render app domain (update after deployment)
ALLOWED_HOSTS=your-app-name.onrender.com,*.onrender.com

# CSRF trusted origins (update with your domain)
CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com,https://*.onrender.com

# Timezone
TIME_ZONE=UTC

# PostgreSQL Database URL (set this in your environment)
# DATABASE_URL=your_database_url_here

# Port (Render will set this automatically)
PORT=8000